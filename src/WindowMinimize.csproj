<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
        <UseWindowsForms>true</UseWindowsForms>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <!-- The app does not use ICU data; disabling it avoids pulling in the native ICU library
             and keeps the self-contained single file runnable as-is -->
        <InvariantGlobalization>true</InvariantGlobalization>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>app.ico</ApplicationIcon>
        <RootNamespace>WindowMinimize</RootNamespace>
        <AssemblyName>WindowMinimize</AssemblyName>
        <Product>WindowMinimize</Product>
        <AssemblyTitle>WindowMinimize</AssemblyTitle>
        <Company>WindowMinimize</Company>
        <Version>1.0.0</Version>
        <FileVersion>1.0.0.0</FileVersion>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <NeutralLanguage>en</NeutralLanguage>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
        <DebugType>none</DebugType>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <!-- Publish settings: win-x64 + self-contained + single file; the output does not depend
             on the local .NET runtime -->
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <SelfContained>true</SelfContained>
        <PublishSingleFile>true</PublishSingleFile>
        <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <PublishTrimmed>false</PublishTrimmed>
        <PublishReadyToRun>false</PublishReadyToRun>
        <!-- The icon is embedded into the exe via ApplicationIcon, so it does not need to go
             into the assembly resources -->
        <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    </PropertyGroup>

    <ItemGroup>
        <!-- The unit tests cover internal types such as HotkeySpec directly -->
        <InternalsVisibleTo Include="WindowMinimize.Tests" />
    </ItemGroup>

</Project>
