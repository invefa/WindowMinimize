<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <!-- The framework keeps its plain form on purpose. A Windows version such as
             net8.0-windows10.0.17763.0 pulls the WinRT projections into the publish output
             (Microsoft.Windows.SDK.NET.dll, about 23 MB unpacked), and this tool uses no WinRT
             API at all. -->
        <TargetFramework>net8.0-windows</TargetFramework>
        <UseWindowsForms>true</UseWindowsForms>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <!-- The interface follows the system language, and that needs the culture aware .NET
             globalization (the ICU library, part of Windows 10 1903 and later). It does not add
             anything to the publish output, the single file stays a single file. -->
        <InvariantGlobalization>false</InvariantGlobalization>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>app.ico</ApplicationIcon>
        <RootNamespace>WindowMinimize</RootNamespace>
        <AssemblyName>WindowMinimize</AssemblyName>
        <Product>WindowMinimize</Product>
        <AssemblyTitle>WindowMinimize</AssemblyTitle>
        <Company>WindowMinimize</Company>
        <Version>1.2.2</Version>
        <FileVersion>1.2.2.0</FileVersion>
        <AssemblyVersion>1.2.2.0</AssemblyVersion>
        <NeutralLanguage>en</NeutralLanguage>
        <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
        <DebugType>none</DebugType>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <!-- Publish settings: win-x64 + self-contained + single file; the output does not depend
             on the local .NET runtime -->
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <SelfContained>true</SelfContained>
        <PublishSingleFile>true</PublishSingleFile>
        <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <PublishTrimmed>false</PublishTrimmed>
        <PublishReadyToRun>false</PublishReadyToRun>
        <!-- The icon is embedded into the exe via ApplicationIcon, so it does not need to go
             into the assembly resources -->
        <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    </PropertyGroup>

    <ItemGroup>
        <!-- The unit tests cover internal types such as HotkeySpec directly -->
        <InternalsVisibleTo Include="WindowMinimize.Tests" />
    </ItemGroup>

    <ItemGroup>
        <!-- The default embedded resource items are off, so the string table is listed by hand.
             The zh-Hans file becomes the satellite assembly that carries the Chinese text. -->
        <EmbeddedResource Include="Resources\Strings.resx" />
        <EmbeddedResource Include="Resources\Strings.zh-Hans.resx" />
    </ItemGroup>

</Project>
